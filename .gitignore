.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.claude/
CLAUDE.local.md
# Build output: the compiled Fortran under build/fortran/, PyInstaller's
# dist/ and build/, and wheels.
dist/
build/
*.egg-info/
*.o
*.mod
# A calculation's scratch files. The program writes its output where
# mobcal.in says; tests and the driver run in temporary directories.
*.out
!fortran/sample-output/*.out
!tests/elements/*.out
!tests/reference/*.out
# The ORCA outputs mobcal import is tested on: fixtures, pinned in tests/data/qm/SHA256SUMS.
!tests/data/qm/orca/*/*.out
